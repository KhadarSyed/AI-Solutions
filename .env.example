# ── Core ────────────────────────────────────────────────────────────────
APP_ENV=dev
API_PORT=8002
ADMIN_API_KEY=change-me-admin-key          # seeds the first admin user

# ── Database (host port 5434 → container 5432) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://prsol:prsol@localhost:5434/prsol
# Inside docker-compose the api service overrides host → postgres:5432

# ── Redis (host port 6381 → container 6379) ─────────────────────────────
REDIS_URL=redis://localhost:6381/0

# ── Neo4j (Mem0 graph store; host 7688 → container 7687) ────────────────
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=prsolneo4j

# ── LLM providers ───────────────────────────────────────────────────────
LLM_PROVIDER=claude                         # claude primary; Azure OpenAI = fallback
LLM_PROVIDER_OVERRIDES={}                   # per-stage, e.g. {"tagging":"gpt"}
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                      # https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
MAX_OUTPUT_TOKENS=32000                     # clamped per-model in registry
LLM_BATCH_SIZE=20
LLM_CONCURRENCY=5

# ── Tracing (both optional — empty disables) ────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-intelligence-agent
LOGFIRE_TOKEN=

# ── Search / ingestion connectors (empty key disables that connector) ───
SEARXNG_URL=http://localhost:8083
SERPAPI_API_KEY=
TAVILY_API_KEY=
APIFY_TOKEN=
XPOZ_API_KEY=                               # reserved stub
SIMILARWEB_API_KEY=

# ── Execution ───────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=4
RUN_EVENT_RETENTION_DAYS=30

# ── Browser MCP (About/Contact navigation + self-heal browser path) ─────
BROWSER_MCP_ENABLED=false                   # needs Node.js
BROWSER_MCP_COMMAND=npx -y @agent360/browser-mcp

# ── Sandbox (Phase C) ───────────────────────────────────────────────────
SANDBOX_BACKEND=docker                      # docker | e2b
SANDBOX_CONTAINER=prsol-sandbox
E2B_API_KEY=

# ── Artifact storage ────────────────────────────────────────────────────
ARTIFACT_BACKEND=postgres                   # postgres | s3

# ── Channels (Phase D) ──────────────────────────────────────────────────
TEAMS_MCP_URL=                              # https://<render-app>/mcp — empty disables Teams
SMTP_HOST=localhost
SMTP_PORT=3025
IMAP_HOST=localhost
IMAP_PORT=3143
AGENT_EMAIL=agent@prsol.local
