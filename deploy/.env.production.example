# PR Intelligence Agent — production environment checklist.
# Set these in the Render dashboard (Environment) for the prsol-api service.
# NEVER commit real values. Local .env stays for local dev only.

# --- core infra (Render wires REDIS_URL + ADMIN_API_KEY automatically) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME   # Render Internal URL + async driver
REDIS_URL=<auto from prsol-redis>
ADMIN_API_KEY=<auto-generated; the console/API admin key>

# --- graph memory (Neo4j AuraDB free tier) ---
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<aura password>

# --- LLM (Claude primary, Azure fallback + embeddings) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=<real key so Claude-primary works; empty forces Azure fallback>
AZURE_OPENAI_API_KEY=<...>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=<REAL embedding deployment; fixes the relevancy/RAG 404>

# --- channels ---
TEAMS_MCP_URL=https://teams-mcp-emrk.onrender.com/mcp
# teams token: place data/local/teams_token.json on the mounted disk once (see runbook)

# --- sources ---
XPOZ_API_KEY=<...>
XPOZ_MCP_URL=https://mcp.xpoz.ai/mcp
SERPAPI_API_KEY=<...>
TAVILY_API_KEY=<...>
APIFY_TOKEN=<...>
PEXELS_API_KEY=<...>
SEARXNG_URL=            # empty in prod (no SearXNG container)

# --- dashboards / hosting ---
DASHBOARD_ASSET_MODE=cdn
VERCEL_TOKEN=<create at vercel.com/account/tokens; enables automated per-report deploys>
